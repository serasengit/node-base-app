{
  "name": "chg-gestor-documental-back-end",
  "version": "1.0.0",
  "description": "CHG Gestor Documental backend project",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "prestart": "npm run lint && npm run build",
    "prestart:local": "npm run build",
    "start": "ts-node -r dotenv/config server.ts dotenv_config_path=environments/.env.%npm_config_env%",
    "start:local": "ts-node -r dotenv/config server.ts dotenv_config_path=environments/.env.%npm_config_env%",
    "start:live": "nodemon -r  dotenv/config server.ts dotenv_config_path=environments/.env.%npm_config_env%",
    "test": "mocha -r ts-node/register -r dotenv/config 'app/tests/**/*.ts' dotenv_config_path=environments/.env.test --timeout 100000 --exit",
    "test:coverage": "nyc --reporter=html mocha -r ts-node/register -r dotenv/config 'app/tests/**/*.ts' dotenv_config_path=environments/.env.test --timeout 100000 --exit",
    "lint": "eslint . tsconfig.json --fix",
    "lint-fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "author": "sasensio",
  "license": "ISC",
  "dependencies": {
    "@types/module-alias": "^2.0.1",
    "@types/node": "^16.11.7",
    "@types/express": "^4.17.13",
    "@types/cors": "^2.8.12",
    "@types/dotenv": "^8.2.0",
    "@types/express-validator": "^3.0.0",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "express-validator": "^6.14.0",
    "reflect-metadata": "^0.1.13",
    "status-code-enum": "^1.0.0",
    "ts-node": "^10.4.0",
    "typedi": "^0.10.0",
    "typescript": "^4.5.2",
    "module-alias": "^2.2.2",
    "node": "^17.1.0"
  },
  "devDependencies": {
    "@types/chai": "^4.2.21",
    "@types/faker": "^5.5.9",
    "@types/mocha": "^9.0.0",
    "@types/nodemon": "^1.19.1",
    "@typescript-eslint/eslint-plugin": "^5.4.0",
    "@typescript-eslint/parser": "^5.4.0",
    "chai": "^4.3.4",
    "chai-http": "^4.3.0",
    "eslint": "^8.3.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-import-resolver-typescript": "^2.5.0",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-prettier": "^4.0.0",
    "faker": "^5.5.3",
    "mocha": "^9.1.3",
    "nodemon": "^2.0.15",
    "nyc": "^15.1.0",
    "prettier": "^2.4.1"
  },
  "_moduleAliases": {
    "@models": "dist/app/models",
    "@controllers": "dist/app/controllers",
    "@services": "dist/app/services",
    "@routes": "dist/app/routes",
    "@dtos": "dist/app/dtos",
    "@repositories": "dist/app/repositories",
    "@schemas": "dist/app/schemas",
    "@api-messages": "dist/app/api-messages",
    "@mappers": "dist/app/mappers"
  }
}
