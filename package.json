{
  "name": "node-base-app",
  "version": "1.0.0",
  "description": "Node base app project",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "prestart": "npm run lint && npm run build",
    "start": "ts-node -r dotenv/config server.ts dotenv_config_path=environments/.env.%npm_config_env%",
    "start:live": "nodemon --exec \"npm run start --env=%npm_config_env%\"",
    "start:dev:debug": "nodemon --watch . --ext ts,json --exec \"node --inspect=9229 -r ts-node/register -r tsconfig-paths/register -r dotenv/config server.ts dotenv_config_path=environments/.env.dev\"",
    "dockerize": "docker compose --env-file environments/.env.%npm_config_env% --profile %npm_config_service% up --build -d",
    "db:dev": "npm run dockerize --service=postgres --env=dev",
    "db:test": "npm run dockerize --service=postgres --env=test",
    "test": "npm run build && mocha -r ts-node/register -r tsconfig-paths/register -r dotenv/config \"app/**/*.spec.ts\" dotenv_config_path=environments/.env.test --timeout 100000 --exit",
    "test:coverage": "npm run build && nyc --reporter=lcov mocha -r ts-node/register -r tsconfig-paths/register -r dotenv/config \"app/**/*.spec.ts\" dotenv_config_path=environments/.env.test --timeout 100000 --exit",
    "test:coverage:check": "nyc check-coverage",
    "knex:migrate:make": "node -r dotenv/config ./node_modules/knex/bin/cli.js migrate:make %npm_config_file_name% dotenv_config_path=environments/.env.%npm_config_env%",
    "knex:migrate:latest": "node -r dotenv/config ./node_modules/knex/bin/cli.js migrate:latest dotenv_config_path=environments/.env.%npm_config_env%",
    "knex:migrate:rollback": "node -r dotenv/config ./node_modules/knex/bin/cli.js migrate:rollback dotenv_config_path=environments/.env.%npm_config_env%",
    "knex:seed:make": "node -r dotenv/config ./node_modules/knex/bin/cli.js seed:make %npm_config_file_name% dotenv_config_path=environments/.env.%npm_config_env%",
    "knex:seed:run": "node -r dotenv/config ./node_modules/knex/bin/cli.js seed:run dotenv_config_path=environments/.env.%npm_config_env%",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "sonar": "sonar-scanner"
  },
  "author": "sasensio",
  "license": "ISC",
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/module-alias": "^2.0.4",
    "@types/node": "^25.9.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.2.10",
    "logger": "^0.0.1",
    "module-alias": "^2.3.4",
    "objection": "^3.1.5",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "status-code-enum": "^1.0.0",
    "ts-node": "^10.9.2",
    "typedi": "^0.10.0",
    "typescript": "^6.0.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/chai": "^5.2.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/dotenv": "^8.2.3",
    "@types/faker": "^6.6.11",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.10",
    "@types/nodemon": "^3.1.1",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "chai": "^6.2.2",
    "chai-http": "^5.1.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "faker": "^6.6.6",
    "mocha": "^11.7.6",
    "nodemon": "^3.1.14",
    "nyc": "^18.0.0",
    "prettier": "^3.8.3",
    "sonarqube-scanner": "^4.3.6"
  },
  "nyc": {
    "all": true,
    "extension": [
      ".ts"
    ],
    "include": [
      "app/**/*.ts"
    ],
    "exclude": [
      "app/docs/**",
      "app/**/tests/**",
      "app/**/*.spec.ts",
      "app/test-setup.ts"
    ]
  },
  "_moduleAliases": {
    "@models": "dist/app/models",
    "@controllers": "dist/app/controllers",
    "@services": "dist/app/services",
    "@routes": "dist/app/routes",
    "@dtos": "dist/app/dtos",
    "@repositories": "dist/app/repositories",
    "@schemas": "dist/app/schemas",
    "@api-messages": "dist/app/api-messages"
  }
}
