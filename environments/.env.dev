# Environment mode: development
NODE_ENV=dev
# Server host and port configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
HEALTHCHECK_PORT=3005
# API versioning prefix
SERVER_API=api/v1
# Allowed domains for CORS (comma separated)
DOMAIN_WHITELIST=https://localhost:4200
# PostgreSQL database connection settings
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=node_base_app_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Bcrypt salt rounds for password hashing (higher is more secure but slower)
BCRYPT_SALT_ROUNDS=12
# JWT secrets for signing access and refresh tokens
JWT_ACCESS_SECRET_KEY=node_base_app_access_key
JWT_REFRESH_SECRET_KEY=node_base_app_refresh_key
# JWT expiration times
JWT_ACCESS_EXPIRATION_TIME=15m           # Access token validity duration (15 minutes)
JWT_REFRESH_EXPIRATION_TIME=7d           # Refresh token validity duration (7 days)
JWT_MAX_INACTIVE_TIME=1800000            # Max inactivity time for sliding expiration (30 minutes in ms)
AUTH_RATE_LIMIT_WINDOW_MS=60000          # Auth endpoint rate limit window (60 seconds in ms)
AUTH_RATE_LIMIT_MAX_REQUESTS=10          # Max auth requests allowed per IP in each window
# Docker image and container names
DOCKER_IMAGE_NAME=node-base-app
DOCKER_CONTAINER_NAME=node-base-app
# Logging configuration
LOG_LEVEL=debug
LOGS_FOLDER=logs/dev
# Enable API documentation route (Swagger UI).
ENABLE_API_DOCS=true
